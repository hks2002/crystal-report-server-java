{
  "http": {
    "port": 8091,
    "compressionSupported": false,
    "compressionLevel": 6,
    "decompressionSupported": true
  },
  "srvInfo": {
    "name": "@project.name@",
    "version": "@project.version@",
    "dependencies": "@project.dependencies@"
  },
  "database": {
    "url": "jdbc:sqlserver://127.0.0.1\\x3v12;DatabaseName=x3v12;TrustServerCertificate=true;",
    "driverClassName": "com.microsoft.sqlserver.jdbc.SQLServerDriver",
    "user": "",
    "password": "",
    "jndiName": "jdbc/crystal_report",
    "sqlIntercept": true,
    "pool": {
      "poolName": "CrystalReportPool",
      "maximumPoolSize": 10,
      "minimumIdle": 1,
      "connectionTimeout": 30000,
      "idleTimeout": 600000,
      "maxLifetime": 1800000,
      "leakDetectionThreshold": 0
    }
  },
  "handler": {
    "report": {
      "windows": {
        "reportsPath": "d:/Dev/crystal-report-server-java/reports"
      },
      "linux": {
        "reportsPath": "/usr/share/java/crystal-report-server-java/reports"
      }
    }
  }
}